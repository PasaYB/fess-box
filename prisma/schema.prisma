generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Menfess {
  id        Int      @id @default(autoincrement())
  senderName String?
  content   String
  color     String   @default("#FFF4CC")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}